      "paths": [
        "ableton-sdk/**/*.md"
      ],
      "enabled": true
    },
    {
      "id": "skills",
      "type": "glob",
      "paths": [
        "skills/**/*.md"
      ],
      "enabled": true
    },
    {
      "id": "community",
      "type": "glob",
      "paths": [
        "community/**/*.md"
      ],
      "enabled": true
    },
    {
      "id": "ableton-website-manual",
      "type": "glob",
      "paths": [
        "ableton-website-manual/**/*.md"
      ],
      "source_type": "external_manual",
      "enabled": true
    }
  ]
}
